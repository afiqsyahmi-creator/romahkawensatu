# Copy this file to .env and fill in real values. .env is gitignored.
export APP_NAME="romahkawensatu"
export DEBUG="true"
export SECURITY_SALT="CHANGE_ME_run__php_-r_echo_bin2hex(random_bytes(32));"

# MySQL connection
export DB_HOST="localhost"
export DB_PORT="3306"
